{
  "name": "pc-shop-empire",
  "productName": "PC Shop Empire",
  "version": "1.1.6",
  "description": "Professional computer store and technical service management simulation",
  "main": "main.js",
  "author": "cixanla",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "test": "node tests/smoke-test.js && node tests/simulation-test.js",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "package:mac:arm64": "electron-forge package --platform=darwin --arch=arm64",
    "package:mac:intel": "electron-forge package --platform=darwin --arch=x64",
    "make:mac": "electron-forge make --platform=darwin"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^43.1.1"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
